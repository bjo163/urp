# Local development only. Never reuse these values in production.
POSTGRES_DB=urp_dev
POSTGRES_USER=urp_dev
POSTGRES_PASSWORD=urp_dev_only_change_me
POSTGRES_PORT=5432

URP_API_BIND=0.0.0.0:8080
URP_LOG=info
URP_DATABASE_URL=postgres://urp_dev:urp_dev_only_change_me@127.0.0.1:5432/urp_dev
URP_STORAGE_PATH=./var/storage

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/api/v1

# Reserved for later components; configure only when their owning tasks land.
URP_WORKER_CONCURRENCY=4
