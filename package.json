{
  "name": "urp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26 <27",
    "pnpm": "10.34.9"
  },
  "scripts": {
    "dev:web": "pnpm --filter @urp/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write \"apps/web/**/*.{ts,tsx,css,json,mjs}\" \"package.json\" \"tsconfig.base.json\" \"pnpm-workspace.yaml\" \"infra/compose/**/*.yml\" \".github/workflows/**/*.yml\"",
    "format:check": "prettier --check \"apps/web/**/*.{ts,tsx,css,json,mjs}\" \"package.json\" \"tsconfig.base.json\" \"pnpm-workspace.yaml\" \"infra/compose/**/*.yml\" \".github/workflows/**/*.yml\"",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
